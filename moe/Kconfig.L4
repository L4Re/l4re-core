menu "Moe"
	visible if EXPERT

config MOE_DEBUG_NAMES
	bool "Set jdb names for created kernel objects"
	help
	  With this option enabled, Moe will register names in jdb for all
	  objects it creates.

	  This is a debugging and development feature.

config MOE_BOOT_FB
	bool "Pass-on the bootloader's frame buffer"
	default y
	help
	  Add support to expose the bootloader's frame buffer as special
	  dataspace.

	  If unsure, say y.

choice
	prompt "Page allocator"
	default MOE_PAGE_ALLOC_TREE

config MOE_PAGE_ALLOC_LIST
	bool "List-based page allocator"
	help
	  First-fit page allocator based on a linked list.

	  O(n) worst-case allocation complexity.
	  O(n) free complexity.

config MOE_PAGE_ALLOC_TREE
	bool "Tree-based page allocator"
	help
	  First-fit page allocator based on an AVL tree.

	  O(n log n) worst-case allocation complexity.
	  O(log n) free complexity.
	  It drastically improves page free performance with only minor allocation
	  performance overhead.

endchoice

endmenu
